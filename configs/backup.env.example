# Copy to configs/backup.env or run ./init.sh to generate secrets automatically.
# Never commit configs/backup.env.

# Required secrets (minimum 32 characters)
RESTIC_PASSWORD=replace-with-a-random-value-of-at-least-32-characters
PROFILE_SECRET_KEY=replace-with-a-different-random-32-character-value
JWT_SECRET_KEY=replace-with-another-random-value-of-at-least-32-characters
ADMIN_USERNAME=admin
# Set either ADMIN_PASSWORD or an bcrypt ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_PASSWORD_HASH=
JWT_ACCESS_TOKEN_EXPIRES=3600

# Storage and retention
RESTIC_REPO=/var/backups/restic-repo
PROFILES_STORAGE=/var/backups/profiles.json
RESTIC_REPOSITORIES_STORAGE=/var/backups/restic_repositories.json
RETENTION_DAYS=30
RETENTION_WEEKLY=12
RETENTION_MONTHLY=12
LOCAL_RETENTION_DAYS=7

# Legacy PostgreSQL backup
PG_HOST=postgres.example.internal
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=all

# Legacy Redis backup
REDIS_HOST=redis.example.internal
REDIS_PORT=6379
REDIS_PASSWORD=

# Legacy MongoDB backup
MONGO_HOST=mongodb.example.internal
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=
MONGO_DATABASE=all

# Legacy Elasticsearch backup
ES_HOST=elasticsearch.example.internal
ES_PORT=9200
ES_USER=
ES_PASSWORD=
SNAPSHOT_REPO=backup

# Legacy local files backup
GLUSTER_MOUNT=/mnt/gluster
CONFIG_DIRS="/etc/haproxy /etc/keepalived"

# SSH configuration-backup profiles
CONFIG_BACKUP_SSH_PRIVATE_KEY=/run/secrets/config-backup/id_ed25519
CONFIG_BACKUP_SSH_PUBLIC_KEY_FILE=/run/secrets/config-backup/id_ed25519.pub
CONFIG_BACKUP_SSH_KNOWN_HOSTS=/run/secrets/config-backup/known_hosts
CONFIG_BACKUP_SSH_CONNECT_TIMEOUT=10

# Cron and monitoring
BACKUP_CRON=0 2 * * * /scripts/backup-all.sh full >> /var/backups/cron.log 2>&1
MONITOR_INTERVAL_SECONDS=3600
MAX_REQUEST_BYTES=1048576
